{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kubernetes Cluster Configuration",
  "description": "Configuration for a Managed Kubernetes Cluster (Cluster API, kubeadm on Proxmox)",
  "type": "object",
  "required": ["tenant", "name", "version", "network"],
  "properties": {
    "tenant": {
      "type": "string",
      "description": "Owning tenant name",
      "pattern": "^([a-z][a-z0-9-]*)?$",
      "maxLength": 63
    },
    "name": {
      "type": "string",
      "description": "Cluster instance name",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 32
    },

    "version": {
      "type": "string",
      "description": "Kubernetes version. Must be one of the versions in .images — the chart fails with the supported list if it is not.",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },

    "controlPlane": {
      "type": "object",
      "description": "Control plane sizing and availability",
      "default": {},
      "properties": {
        "highlyAvailable": {
          "type": "boolean",
          "description": "Run 3 stacked-etcd control plane nodes instead of 1",
          "default": false
        },
        "numCores":  { "type": "integer", "minimum": 1, "maximum": 32,     "default": 2 },
        "memoryMiB": { "type": "integer", "minimum": 2048, "maximum": 131072, "default": 4096 },
        "diskGb":    { "type": "integer", "minimum": 20, "maximum": 2048,  "default": 40 }
      }
    },

    "nodePools": {
      "type": "array",
      "description": "Worker node pools. Each becomes a MachineDeployment with its own machine template; changing any spec field rolls that pool.",
      "minItems": 1,
      "default": [{ "name": "default", "replicas": 2, "numCores": 2, "memoryMiB": 4096, "diskGb": 40 }],
      "items": {
        "type": "object",
        "required": ["name", "replicas"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Pool name, unique within the cluster",
            "pattern": "^[a-z][a-z0-9-]*$",
            "minLength": 1,
            "maxLength": 20
          },
          "replicas":  { "type": "integer", "description": "Number of nodes in this pool", "minimum": 0, "maximum": 50, "default": 2 },
          "numCores":  { "type": "integer", "minimum": 1, "maximum": 32,     "default": 2 },
          "memoryMiB": { "type": "integer", "minimum": 1024, "maximum": 131072, "default": 4096 },
          "diskGb":    { "type": "integer", "minimum": 20, "maximum": 2048,  "default": 40 }
        }
      }
    },

    "network": {
      "type": "object",
      "description": "Cluster addressing. CAPMOX has no DHCP path, so node addresses are explicit and must not overlap between clusters.",
      "required": ["controlPlaneEndpoint", "nodeAddresses"],
      "properties": {
        "controlPlaneEndpoint": {
          "type": "string",
          "description": "Virtual IP for the API server, held by kube-vip. Must be unique, outside the DHCP scope, and outside every nodeAddresses range.",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$"
        },
        "nodeAddresses": {
          "type": "array",
          "description": "Ranges the cluster's nodes draw from, e.g. 192.168.10.40-192.168.10.49. Must not overlap another cluster.",
          "minItems": 1,
          "items": { "type": "string", "minLength": 7 }
        },
        "podCIDR":     { "type": "string", "default": "10.244.0.0/16" },
        "serviceCIDR": { "type": "string", "default": "10.96.0.0/12" }
      }
    },

    "images": {
      "type": "object",
      "description": "PLATFORM-OWNED. Maps a Kubernetes version to the Proxmox VM template that has that version baked in. Adding a version here is what makes it selectable.",
      "default": {},
      "additionalProperties": {
        "type": "object",
        "required": ["templateID"],
        "properties": {
          "templateID": { "type": "integer", "description": "Proxmox VMID of the image-builder template" }
        }
      }
    },

    "infra": {
      "type": "object",
      "description": "PLATFORM-OWNED. Proxmox placement and addressing defaults shared by every cluster.",
      "default": {},
      "properties": {
        "sourceNode":  { "type": "string", "default": "pve" },
        "allowedNodes": { "type": "array", "default": ["pve"], "items": { "type": "string" } },
        "storage":     { "type": "string", "default": "bulk" },
        "bridge":      { "type": "string", "default": "vmbr0" },
        "gateway":     { "type": "string", "default": "192.168.10.1" },
        "prefix":      { "type": "integer", "minimum": 1, "maximum": 32, "default": 24 },
        "dnsServers":  { "type": "array", "default": ["192.168.10.2"], "items": { "type": "string" } },
        "region":      { "type": "string", "description": "Proxmox CCM/CSI region — must match the config secret", "default": "home" }
      }
    },

    "addons": {
      "type": "object",
      "description": "PLATFORM-OWNED. Chart versions for the addons every cluster gets.",
      "default": {},
      "properties": {
        "cilium": { "type": "string", "default": "1.20.0" },
        "ccm":    { "type": "string", "default": "0.2.30" },
        "csi":    { "type": "string", "default": "0.5.10" },
        "kubeVip": { "type": "string", "default": "v1.2.3" }
      }
    }
  }
}
